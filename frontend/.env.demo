# Demo Mode Configuration
# Copy this file to .env.local to enable demo mode

# Enable demo mode - set to 'true' for demo, 'false' for production
VITE_DEMO_MODE=true

# Demo mode features
VITE_DEMO_SHOW_BANNER=true
VITE_DEMO_DISABLE_EXTERNAL_APIS=true
VITE_DEMO_USE_MOCK_DATA=true
VITE_DEMO_MEMORY_ONLY_STORAGE=true