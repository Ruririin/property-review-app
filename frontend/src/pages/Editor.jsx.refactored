              <span className="d-none d-md-inline">{isLoadingLroForms ? 'Loading...' : 'Load from Database'}</span>
              <span className="d-md-none">DB</span>
            </button>
            
            {isLroDropdownOpen && (
              <div 
                className="position-absolute bg-white border rounded shadow-lg"
                style={{
                  top: '100%',
                  right: '0',
                  width: '380px',
                  maxHeight: '420px',
                  overflowY: 'auto',
