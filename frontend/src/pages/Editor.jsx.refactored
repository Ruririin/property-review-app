            color: "white",
            border: "none",
            borderRadius: "50%",
            fontSize: "20px",
            zIndex: 1100,
            cursor: "pointer",
            boxShadow: "0 2px 10px rgba(0,0,0,0.2)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          {isMobileSidebarOpen ? "×" : "☰"}
        </button>
      )}
      


      {/* Custom scrollbar styles */}
      <style>
        {`
