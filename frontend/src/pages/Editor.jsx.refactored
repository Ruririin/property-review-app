          }
        `}
      </style>
      {/* Professional Navbar */}
      <nav className={`navbar navbar-light bg-white shadow-sm px-3 py-0 d-flex justify-content-between align-items-center position-fixed w-100`} style={{ top: 0, zIndex: 1003, height: NAVBAR_HEIGHT }}>
        {/* Left - Logo & Brand */}
