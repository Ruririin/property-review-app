# Django Environment Variables - TEMPLATE FILE
# Copy this file to .env and fill in your own values
# NEVER commit .env file to version control!

# Security - Generate a new secret key for each environment
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-replace-with-50-random-characters

# Debug mode - MUST be False in production
DEBUG=True

# Allowed hosts - comma-separated list of allowed domains
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=property_review
DB_USER=your_database_user
DB_PASSWORD=your_strong_database_password
DB_HOST=localhost
DB_PORT=3306

# Forms Database Configuration (MySQL for LRO forms)
FORMS_DB_ENGINE=django.db.backends.mysql
FORMS_DB_NAME=db_neitclem_app
FORMS_DB_USER=your_forms_db_user
FORMS_DB_PASSWORD=your_strong_forms_db_password
FORMS_DB_HOST=localhost
FORMS_DB_PORT=3306

# CORS Settings - Restrict to your frontend domains
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# SSL/HTTPS - Set to True in production with proper HTTPS setup
SECURE_SSL_REDIRECT=False

# PRODUCTION CHECKLIST:
# [ ] Generate new SECRET_KEY (different from this template)
# [ ] Set DEBUG=False
# [ ] Create strong database passwords (NOT root/root)
# [ ] Update ALLOWED_HOSTS with your production domain
# [ ] Update CORS_ALLOWED_ORIGINS with your production frontend URL
# [ ] Set SECURE_SSL_REDIRECT=True
# [ ] Never commit .env file to git
# [ ] Use environment-specific secrets management in production
