# Django Environment Variables - PRODUCTION
# ==========================================
# IMPORTANT: Copy this file to .env on production server
# Fill in all values with production credentials

# Security - GENERATE A NEW SECRET KEY FOR PRODUCTION!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-64-CHARACTER-STRING

# CRITICAL: Set to False in production!
DEBUG=False

# CRITICAL: Set to your actual domain(s), comma-separated
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration (MySQL) - PRODUCTION
DB_ENGINE=django.db.backends.mysql
DB_NAME=property_review_prod
DB_USER=your_db_user
DB_PASSWORD=STRONG-DATABASE-PASSWORD-HERE
DB_HOST=your-database-host
DB_PORT=3306

# Forms Database Configuration (MySQL)
FORMS_DB_ENGINE=django.db.backends.mysql
FORMS_DB_NAME=db_neitclem_app_prod
FORMS_DB_USER=your_forms_db_user
FORMS_DB_PASSWORD=STRONG-FORMS-DB-PASSWORD-HERE
FORMS_DB_HOST=your-database-host
FORMS_DB_PORT=3306

# CORS Settings - PRODUCTION DOMAINS ONLY
# Replace with your actual frontend domain(s)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/HTTPS - REQUIRED in production
SECURE_SSL_REDIRECT=True

# Email Configuration (Optional - for password reset, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password

# Static and Media Files
# Configure these based on your hosting setup (S3, local storage, etc.)
STATIC_URL=/static/
MEDIA_URL=/media/

# Cache Configuration (Recommended: Redis)
# REDIS_URL=redis://localhost:6379/1

# Logging (Optional)
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/property_review/app.log
