# Django Environment Variables - PRODUCTION TEMPLATE
# ===================================================
# Copy this file to .env on your production server
# Fill in your actual production values

# Security - GENERATE A NEW SECRET KEY FOR PRODUCTION!
# Run on server: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=GENERATE_NEW_SECRET_KEY_HERE

# Debug - MUST be False in production
DEBUG=False

# Allowed hosts - Add your production domain
ALLOWED_HOSTS=pr-neitclem.gratusinc.org,www.pr-neitclem.gratusinc.org

# Database Configuration (MySQL) - PRODUCTION
# Use your production database credentials (NOT root!)
DB_ENGINE=django.db.backends.mysql
DB_NAME=property_review_production
DB_USER=your_production_db_user
DB_PASSWORD=your_strong_production_password
DB_HOST=localhost
DB_PORT=3306

# Forms Database Configuration (MySQL) - PRODUCTION
# Use your production forms database credentials (NOT root!)
FORMS_DB_ENGINE=django.db.backends.mysql
FORMS_DB_NAME=db_neitclem_app_production
FORMS_DB_USER=your_production_forms_user
FORMS_DB_PASSWORD=your_strong_forms_password
FORMS_DB_HOST=localhost
FORMS_DB_PORT=3306

# CORS Settings - PRODUCTION FRONTEND URL
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com,https://pr-neitclem.gratusinc.org

# SSL/HTTPS - Enabled for production (already set in settings_production.py)
SECURE_SSL_REDIRECT=True

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before going live, ensure:
# [ ] Generated NEW SECRET_KEY (different from dev)
# [ ] Set DEBUG=False
# [ ] Created production database users with strong passwords
# [ ] Updated ALLOWED_HOSTS with your domain
# [ ] Updated CORS_ALLOWED_ORIGINS with your frontend URL
# [ ] SSL certificate is installed and working
# [ ] Tested HTTPS redirect
# [ ] Static files collected: python manage.py collectstatic
# [ ] Database migrations run: python manage.py migrate
# [ ] Created superuser: python manage.py createsuperuser
# [ ] Backed up production data
